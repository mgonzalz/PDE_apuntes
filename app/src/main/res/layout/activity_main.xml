<?xml version="1.0" encoding="utf-8"?>
<!--El constraint layout permite relacionar la posición con los otros elementos. No se pueden poner coordenadas fijas, no funciona-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
    Definimos parent como la pantalla principal.
    Añadir identificador a la vista para poder acceder a ella y manipularla.
    Podemos por el identificador recuperar la vista y modificar sus atributos de forma dinámica, o atribuirle atributos de manera estática con el layout.
    -->

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Hola Mundo!"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.731" />

    <Button
        android:id="@+id/btCambiarTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        android:text="Pulsame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editNumber2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="332dp"
        android:layout_marginEnd="36dp"
        android:ems="10"
        android:hint="Introduce el segundo número"
        android:inputType="numberSigned"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editNumber1"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editNumber1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="104dp"
        android:ems="10"
        android:hint="Introduce el primer número"
        android:inputType="numberSigned"
        app:layout_constraintBottom_toBottomOf="@+id/editNumber2"
        app:layout_constraintEnd_toStartOf="@+id/editNumber2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editNumber2"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="4dp"
        android:text="El resultado es"
        app:layout_constraintEnd_toEndOf="@+id/btOperar"
        app:layout_constraintTop_toBottomOf="@+id/btOperar" />

    <Button
        android:id="@+id/btOperar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="4dp"
        android:text="Operar"
        app:layout_constraintEnd_toStartOf="@+id/editNumber2"
        app:layout_constraintTop_toBottomOf="@+id/editNumber2" />

    <!--Los Radio Group permiten seleccionar una opción de un grupo de opciones.-->
    <RadioGroup
        android:id="@+id/rgOperacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="409dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editNumber1"
        app:layout_constraintVertical_bias="0.4">

        <RadioButton
            android:id="@+id/rbSumar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Sumar" />

        <RadioButton
            android:id="@+id/rbRestar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Restar" />

    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>