<?xml version="1.0" encoding="utf-8"?>
<!--El constraint layout permite relacionar la posición con los otros elementos. No se pueden poner coordenadas fijas, no funciona-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
    Definimos parent como la pantalla principal.
    Añadir identificador a la vista para poder acceder a ella y manipularla.
    Podemos por el identificador recuperar la vista y modificar sus atributos de forma dinámica, o atribuirle atributos de manera estática con el layout.
    -->

    <Button
        android:id="@+id/btAcercaDe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:text="@string/btAcercaDe"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editNumber2"
        android:layout_width="98dp"
        android:layout_height="48dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="92dp"
        android:ems="10"
        android:hint="Segundo número"
        android:inputType="numberSigned"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.074"
        app:layout_constraintStart_toEndOf="@+id/editNumber1"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Los Radio Group permiten seleccionar una opción de un grupo de opciones.-->

    <EditText
        android:id="@+id/editNumber1"
        android:layout_width="98dp"
        android:layout_height="48dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="92dp"
        android:ems="10"
        android:hint="Primer número"
        android:inputType="numberSigned"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/mensajeResultado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btOperar" />

    <Button
        android:id="@+id/btOperar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="@string/btOperar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editNumber1" />

    <RadioGroup
        android:id="@+id/rgOperacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvResultado">

        <RadioButton
            android:id="@+id/rbSumar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/rbSumar" />

        <RadioButton
            android:id="@+id/rbRestar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="@string/rbRestar" />

    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>