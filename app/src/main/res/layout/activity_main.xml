<?xml version="1.0" encoding="utf-8"?>
<!--El constraint layout permite relacionar la posición con los otros elementos. No se pueden poner coordenadas fijas, no funciona-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
    Definimos parent como la pantalla principal.
    Añadir identificador a la vista para poder acceder a ella y manipularla.
    Podemos por el identificador recuperar la vista y modificar sus atributos de forma dinámica, o atribuirle atributos de manera estática con el layout.
    -->

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Hola Mundo!"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.731" />

    <Button
        android:id="@+id/btCambiarTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        android:text="Pulsame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editNumber1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="104dp"
        android:ems="10"
        android:hint="Introduce el primer número"
        android:inputType="numberSigned"
        app:layout_constraintBottom_toBottomOf="@+id/editNumber2"
        app:layout_constraintEnd_toStartOf="@+id/editNumber2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editNumber2" />

    <EditText
        android:id="@+id/editNumber2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="36dp"
        android:ems="10"
        android:hint="Introduce el segundo número"
        android:inputType="numberSigned"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/editNumber1"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btSumar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="5dp"
        android:onClick="onBtSumar"
        android:text="Sumar"
        app:layout_constraintEnd_toStartOf="@+id/editNumber2"
        app:layout_constraintTop_toBottomOf="@+id/editNumber2" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="1dp"
        android:text="El resultado es"
        app:layout_constraintEnd_toEndOf="@+id/btSumar"
        app:layout_constraintTop_toBottomOf="@+id/btSumar" />

</androidx.constraintlayout.widget.ConstraintLayout>